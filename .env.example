# Passio / Ecomobi Affiliate API — xem docs/docs-passio-api.md
# Copy thành .env.local và điền giá trị (không commit .env.local)

# Base URL (vd: https://ga.passio.eco)
PASSIO_API_BASE_URL=https://ga.passio.eco

# Token (trong doc Passio mục "Token") — CHỈ điền giá trị token, không phải cả URL
# Ví dụ: jyHXGExroViXgTgqRdgJw
PASSIO_API_KEY=your_passio_token_here

# Token Private (trong doc Passio mục "Token Private") — dùng cho OAuth nếu cần
# PASSIO_TOKEN_PRIVATE=
